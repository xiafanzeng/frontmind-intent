{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "module",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "module/server/**/*.ts",
    "module/contracts/**/*.ts",
    "module/schema/**/*.ts",
    "module/client/**/*.ts",
    "module/client/**/*.tsx"
  ],
  "exclude": [
    "module/client/**/*.test.ts"
  ]
}
