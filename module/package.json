    "react": "19.2.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.7.0",
    "@types/react": "^19.2.1",
    "@types/express": "4.17.21",
    "vitest": "2.1.9"
  },
  "exports": {
