{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "server/**/*.ts",
    "contracts/**/*.ts",
    "schema/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx"
  ],
  "exclude": [
    "client/**/*.test.ts"
  ]
}
